{
  "$schema": "https://opencode.ai",
  "watcher": {
    "ignore": [
      "**/venv/**",
      "**/.venv/**",
      "**/site-packages/**",
      "**/*.dll",
      "**/*.lib",
      "**/*.safetensors",
      "**/*.ndjson",
      "**/.godot/**",
      "**/exported/**"
    ]
  },
  "provider": {
    "hive-memory": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Hive Memory (curated context)",
      "options": {
        "baseURL": "http://127.0.0.1:8765/v1/openai"
      },
      "models": {
        "prism-ml/bonsai-27b": {
          "name": "bonsai-27b via Hive",
          "tool_call": true
        }
      }
    }
  }
}