{
  "$schema": "https://opencode.ai",
  "watcher": {
    "ignore": [
      "**/venv/**",
      "**/.venv/**",
      "**/site-packages/**",
      "**/*.dll",
      "**/*.lib",
      "**/*.safetensors",
      "**/*.ndjson",
      "**/.godot/**",
      "**/exported/**"
    ]
  },
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local, hive-curated via plugin)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      }
    }
  }
}